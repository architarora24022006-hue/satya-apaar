# Environment Configuration for SATYA-APAAR Platform
ENVIRONMENT=development
PROJECT_NAME="SATYA-APAAR"
API_V1_STR="/api/v1"

# Database Configuration
# Docker default: postgresql://satya_user:satya_secure_password_2026@db:5432/satya_apaar_db
# Local host default: postgresql://satya_user:satya_secure_password_2026@localhost:5432/satya_apaar_db
# Standalone SQLite fallback: sqlite:///./satya_apaar.db
DATABASE_URL=postgresql://satya_user:satya_secure_password_2026@localhost:5432/satya_apaar_db
SQLITE_FALLBACK=true

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & Cryptography
SECRET_KEY=satya_apaar_jwt_super_secret_key_sih2026_demo_key_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256 Key for PII at rest (must be 32 bytes)
AES_SECRET_KEY=satya_aes_256_super_key_32bytes_len!

# AICTE Public & Private Key (Ed25519) for Verifiable Credentials
# Auto-generated on startup if not supplied
ED25519_PRIVATE_KEY_B64=
ED25519_PUBLIC_KEY_B64=

# AI & LLM Settings
ANTHROPIC_API_KEY=mock_claude_api_key_or_set_real_key
AI_MOCK_FALLBACK=true

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
